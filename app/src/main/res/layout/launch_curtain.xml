<?xml version="1.0" encoding="utf-8"?>
<!-- What a launch from a shortcut shows until the game's picture: black, the logo, a thin arc turning around it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launchCurtain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:elevation="10000dp">

    <ProgressBar
        android:id="@+id/launchCurtainRing"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/launch_ring"
        android:indeterminateDuration="1100"
        android:indeterminateOnly="true"
        android:interpolator="@android:anim/linear_interpolator" />

    <ImageView
        android:id="@+id/launchCurtainLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher_foreground" />
</FrameLayout>
